# Environment Configuration Example

# Application Settings
APP_ENV=development
PROJECT_NAME="Web Assistant"
VERSION=1.0.0
DEBUG=true

# API Settings
API_V1_STR=/api/v1

# CORS Settings
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# Langfuse Settings
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY="your-langfuse-public-key"
LANGFUSE_SECRET_KEY="your-langfuse-secret-key"
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM Settings
OPENAI_API_KEY="your-llm-api-key" # e.g. OpenAI API key
DEFAULT_LLM_MODEL=gpt-5.6-luna

# Atlas Cloud (OpenAI-compatible) — alternative to OpenAI, access 59+ LLMs with one key
# Get your free key at: https://www.atlascloud.ai/console/coding-plan
# OPENAI_BASE_URL=https://api.atlascloud.ai/v1
# OPENAI_API_KEY=<your-atlascloud-key>
# DEFAULT_LLM_MODEL=deepseek-ai/deepseek-v4-pro
DEFAULT_LLM_TEMPERATURE=0.2
SESSION_NAMING_ENABLED=true

# JWT Settings
JWT_SECRET_KEY="CHANGE_ME_TO_A_RANDOM_32_PLUS_CHAR_STRING"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# Database Settings
POSTGRES_HOST=db
POSTGRES_DB=mydb
POSTGRES_USER=myuser
POSTGRES_PORT=5432
POSTGRES_PASSWORD=mypassword
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# Rate Limiting Settings
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
RATE_LIMIT_CHAT="100 per minute"
RATE_LIMIT_CHAT_STREAM="100 per minute"
RATE_LIMIT_MESSAGES="200 per minute"
RATE_LIMIT_LOGIN="100 per minute"

# Profiling Settings
PROFILING_DIR=/tmp/fastapi_profiles
PROFILING_THRESHOLD_SECONDS=2.0

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# --- Valkey cache (optional) ------------------------------------------------
# Set to the compose service name to use the container; leave empty for the
# in-memory fallback. The image must be built with the "cache" extra.
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_DB=0
VALKEY_PASSWORD=

# --- Self-hosted Langfuse (compose profile "langfuse", make langfuse-up) -----
# Generate each secret with: openssl rand -hex 32
LANGFUSE_NEXTAUTH_SECRET=changeme-openssl-rand-hex-32
LANGFUSE_SALT=changeme-openssl-rand-hex-32
LANGFUSE_ENCRYPTION_KEY=changeme-openssl-rand-hex-32
LANGFUSE_POSTGRES_PASSWORD=changeme
LANGFUSE_CLICKHOUSE_PASSWORD=changeme
LANGFUSE_MINIO_PASSWORD=changeme
LANGFUSE_REDIS_PASSWORD=changeme
LANGFUSE_NEXTAUTH_URL=http://localhost:3001
LANGFUSE_MINIO_PUBLIC_URL=http://localhost:9190
LANGFUSE_TELEMETRY_ENABLED=false
# First boot provisions this org/project/user and mints the API keys above,
# so LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY work without any manual setup.
LANGFUSE_INIT_ORG_ID=my-agent
LANGFUSE_INIT_ORG_NAME=My Agent
LANGFUSE_INIT_PROJECT_ID=my-agent
LANGFUSE_INIT_PROJECT_NAME=My Agent
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=changeme
